# Supabase — required for shared admin data on Netlify (prices, stock, shipping, couriers)
# Local: copy to .env.local. Netlify: copy netlify.env.example → netlify.env and import that file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by admin API routes and scripts/seed-supabase.mjs (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only for npm run seed:supabase (not required for normal site runtime)
ADMIN_EMAIL=admin@greenhousebz.com
ADMIN_PASSWORD=admin123
