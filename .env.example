# Supabase — required for shared admin data on Netlify (prices, stock, shipping, couriers)
# Set these in Netlify → Site settings → Environment variables, then redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by admin API routes and scripts/seed-supabase.mjs (never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides for seed script
ADMIN_EMAIL=admin@greenhousebz.com
ADMIN_PASSWORD=admin123
